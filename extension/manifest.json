{
  "manifest_version": 3,
  "name": "Zenkai Stream Companion",
  "version": "1.2.0",
  "description": "Direct zero-proxy high-speed streaming for Zenkai. Unlocks Anime (MegaPlay, FlixCloud, AnimeSalt, ACDN) and Movies (MovieBox, Hakunaymatata, BCDNXW) CDNs, and resolves IP-bound ACDN/Abyss streams in your own browser.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "*://*.hakunaymatata.com/*",
    "*://*.aoneroom.com/*",
    "*://*.inmoviebox.com/*",
    "*://*.bcdnxw.com/*",
    "*://bcdnxw.hakunaymatata.com/*",
    "*://*.123moviesfree.club/*",
    "*://*.sflix.film/*",
    "*://*.movieboxonline.net/*",
    "*://*.megaplay.buzz/*",
    "*://*.megap.buzz/*",
    "*://*.nexabloom.top/*",
    "*://*.nexabloom.space/*",
    "*://*.silentforge.top/*",
    "*://*.silentforge.space/*",
    "*://*.stellarfrontier.top/*",
    "*://*.stellarfrontier.space/*",
    "*://*.phantomharbor.top/*",
    "*://*.phantomharbor.space/*",
    "*://*.shadowharbor.top/*",
    "*://*.shadowharbor.space/*",
    "*://*.hiddenvertex.top/*",
    "*://*.hiddenvertex.space/*",
    "*://*.emeralddrift.top/*",
    "*://*.emeralddrift.space/*",
    "*://*.eclipseharbor.top/*",
    "*://*.eclipseharbor.space/*",
    "*://*.shiora.top/*",
    "*://*.shiora.space/*",
    "*://*.akirax.top/*",
    "*://*.akirax.space/*",
    "*://*.imgnex.top/*",
    "*://*.imgnex.space/*",
    "*://*.megacloud.tv/*",
    "*://*.rabbitstream.net/*",
    "*://*.dokicloud.one/*",
    "*://*.reanime.to/*",
    "*://*.reanime.cz/*",
    "*://*.flixcloud.cc/*",
    "*://*.atomic4cdn.com/*",
    "*://*.rundowncdn.com/*",
    "*://*.vividcdn.com/*",
    "*://*.fallencdn.com/*",
    "*://*.enc-dec.app/*",
    "*://*.animesalt.cx/*",
    "*://*.animesalt.ac/*",
    "*://*.animesalt.ro/*",
    "*://*.as-cdn.top/*",
    "*://*.acdn.top/*",
    "*://*.ravok.buzz/*",
    "*://*.animeapps.top/*",
    "*://*.playeng.animeapps.top/*",
    "*://*.krussdomi.com/*",
    "*://*.advancedairesearchlab.com/*",
    "*://zenkai.cfd/*",
    "*://*.zenkai.cfd/*",
    "*://*.pages.dev/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "<all_urls>",
    "*://*.animedekho.app/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "zenkai_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://zenkai.cfd/*",
        "*://*.zenkai.cfd/*",
        "*://*.pages.dev/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Zenkai Stream Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
